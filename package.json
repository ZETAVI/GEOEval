{
  "name": "geoeval",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm openapi:generate && pnpm --filter @geoeval/backend build && pnpm --filter @geoeval/api-client typecheck && pnpm --filter @geoeval/web build",
    "build:public-release": "node deploy/application/check-web-public-build.mjs before && pnpm build && node deploy/application/check-web-public-build.mjs after",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write package.json pnpm-workspace.yaml compose.yaml tsconfig.base.json 'apps/**/*.{json,ts,tsx,css}' 'packages/**/*.{json,ts}' 'scripts/{brand-knowledge,foundation,provider-validation}/*.{json,mjs}'",
    "format:check": "prettier --check package.json pnpm-workspace.yaml compose.yaml tsconfig.base.json 'apps/**/*.{json,ts,tsx,css}' 'packages/**/*.{json,ts}' 'scripts/{brand-knowledge,foundation,provider-validation}/*.{json,mjs}'",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @geoeval/backend test",
    "infra:pull": "docker compose pull",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @geoeval/backend db:generate",
    "db:migrate": "pnpm --filter @geoeval/backend db:migrate",
    "openapi:generate": "pnpm --filter @geoeval/backend openapi:generate && pnpm --filter @geoeval/api-client generate",
    "identity:bootstrap": "pnpm --filter @geoeval/backend identity:bootstrap",
    "identity:cleanup": "pnpm --filter @geoeval/backend identity:cleanup",
    "e0:plan": "node --env-file=.env scripts/provider-validation/e0-runner.mjs plan",
    "e0:probe-plan": "node --env-file=.env scripts/provider-validation/e0-runner.mjs probe-plan",
    "e0:instruction-plan": "node --env-file=.env scripts/provider-validation/e0-runner.mjs instruction-plan",
    "e0:entitlement": "node --env-file=.env scripts/provider-validation/e0-runner.mjs entitlement",
    "e0:probe": "node --env-file=.env scripts/provider-validation/e0-runner.mjs probe",
    "e0:instruction-batch": "node --env-file=.env scripts/provider-validation/e0-runner.mjs instruction-batch",
    "e0:report": "node --env-file=.env scripts/provider-validation/e0-runner.mjs report",
    "s6:plan": "pnpm --filter @geoeval/backend s6:plan",
    "s6:execute": "pnpm --filter @geoeval/backend s6:execute",
    "media-supply:first-batch": "pnpm --filter @geoeval/backend media-supply:first-batch"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
