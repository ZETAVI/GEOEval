{
  "name": "@geoeval/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "GEOEVAL_LOCAL_DEFAULTS=1 vitest run",
    "start:api": "GEOEVAL_LOCAL_DEFAULTS=1 node dist/api-main.js",
    "start:worker": "GEOEVAL_LOCAL_DEFAULTS=1 node dist/worker-main.js",
    "dev:api": "GEOEVAL_LOCAL_DEFAULTS=1 tsx watch src/api-main.ts",
    "dev:worker": "GEOEVAL_LOCAL_DEFAULTS=1 tsx watch src/worker-main.ts",
    "s6:plan": "GEOEVAL_LOCAL_DEFAULTS=1 node --env-file=../../.env --import tsx src/controlled-provider-validation-main.ts plan",
    "s6:execute": "GEOEVAL_LOCAL_DEFAULTS=1 AI_EXECUTION_MODE=real node --env-file=../../.env --import tsx src/controlled-provider-validation-main.ts execute",
    "db:generate": "GEOEVAL_LOCAL_DEFAULTS=1 prisma generate --config prisma.config.ts",
    "db:migrate": "GEOEVAL_LOCAL_DEFAULTS=1 prisma migrate deploy --config prisma.config.ts",
    "openapi:generate": "GEOEVAL_LOCAL_DEFAULTS=1 node --import tsx src/generate-openapi.ts",
    "media-supply:first-batch": "node --import tsx src/media-supply-import-main.ts"
  },
  "dependencies": {
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@nestjs/common": "11.2.2",
    "@nestjs/core": "11.2.2",
    "@nestjs/platform-express": "11.2.2",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bullmq": "6.2.1",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.16.0",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
