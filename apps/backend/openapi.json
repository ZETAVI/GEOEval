  "info": {
    "title": "GEOEval API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FoundationEffectResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "businessKey": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "businessKey",
          "result"
        ]
      },
      "FoundationRecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "PROCESSED"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FoundationEffectResponse"
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "correlationId",
          "effects"
        ]
      },
      "FoundationBacklogResponse": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "number"
          },
          "dispatched": {
            "type": "number"
          }
        },
        "required": [
          "pending",
          "dispatched"
        ]
      },
      "RequestChallengeRequest": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string",
            "example": "13800138000"
          }
        },
        "required": [
          "mobile"
        ]
      },
      "ChallengeResponse": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "developmentCode": {
            "type": "string",
            "description": "Only returned by the local/test adapter"
          }
        },
        "required": [
          "challengeId",
          "expiresAt"
        ]
      },
      "CompleteSessionRequest": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string",
            "example": "13800138000"
          },
          "challengeId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "246810"
          }
        },
        "required": [
          "mobile",
          "challengeId",
          "code"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "TERMINAL_CUSTOMER",
              "OPERATIONS",
              "ADMINISTRATOR",
              "AGENT"
            ]
          }
        },
        "required": [
          "id",
          "mobile",
          "role"
        ]
      },
      "BrandResponse": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "primaryIndustry": {
            "type": "string",
            "nullable": true
          },
          "secondaryIndustry": {
            "type": "string",
            "nullable": true
          },
          "characteristicOne": {
            "type": "string",
            "nullable": true
          },
          "characteristicTwo": {
            "type": "string",
            "nullable": true
          },
          "province": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "contactName": {
            "type": "string",
            "nullable": true
          },
          "contactMobile": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ARCHIVED"
            ]
          },
          "readyForEvaluation": {
            "type": "boolean"
          },
          "missingFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isCurrent": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "readyForEvaluation",
          "missingFields",
          "isCurrent",
          "createdAt",
          "updatedAt"
        ]
      },
      "BrandMutationRequest": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "primaryIndustry": {
            "type": "string",
            "nullable": true
          },
          "secondaryIndustry": {
            "type": "string",
            "nullable": true
          },
          "characteristicOne": {
            "type": "string",
            "nullable": true
          },
          "characteristicTwo": {
            "type": "string",
            "nullable": true
          },
          "province": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "contactName": {
            "type": "string",
            "nullable": true
          },
          "contactMobile": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EvaluationBrandSnapshotResponse": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "primaryIndustry": {
            "type": "string"
          },
          "secondaryIndustry": {
            "type": "string"
          },
          "characteristicOne": {
            "type": "string"
          },
          "characteristicTwo": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "district": {
            "type": "string"
          }
        },
        "required": [
          "companyName",
          "primaryIndustry",
          "secondaryIndustry",
          "characteristicOne",
          "characteristicTwo",
          "province",
          "city",
          "district"
        ]
      },
      "EvaluationQuestionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "BRAND_DIRECTED",
              "INDUSTRY_RECOMMENDATION",
              "CHARACTERISTIC_ONE",
              "CHARACTERISTIC_TWO"
            ]
          },
          "ordinal": {
            "type": "number"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "ordinal",
          "content"
        ]
      },
      "EvaluationPlatformResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ]
      },
      "EvaluationRunResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definitionId": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "EVALUATING",
              "COMPLETED",
              "PLEASE_RETRY"
            ]
          },
          "expectedSampleCount": {
            "type": "number"
          },
          "processedSampleCount": {
            "type": "number"
          },
          "validSampleCount": {
            "type": "number"
          },
          "unavailableSampleCount": {
            "type": "number"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "definitionId",
          "brandId",
          "status",
          "expectedSampleCount",
          "processedSampleCount",
          "validSampleCount",
          "unavailableSampleCount",
          "startedAt",
          "updatedAt"
        ]
      },
      "EvaluationDefinitionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "brandSnapshot": {
            "$ref": "#/components/schemas/EvaluationBrandSnapshotResponse"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationQuestionResponse"
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationPlatformResponse"
            }
          },
          "run": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/EvaluationRunResponse"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "brandId",
          "brandSnapshot",
          "questions",
          "platforms",
          "createdAt"
        ]
      }
    }
  }
}
