generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoundationRecordStatus {
  ACCEPTED
  PROCESSED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  COMPLETED
}

enum AccountRole {
  TERMINAL_CUSTOMER
  OPERATIONS
  ADMINISTRATOR
  AGENT
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum EvaluationQuestionKind {
  BRAND_DIRECTED
  INDUSTRY_RECOMMENDATION
  CHARACTERISTIC_ONE
  CHARACTERISTIC_TWO
}

enum EvaluationRunStatus {
  EVALUATING
  COMPLETED
  PLEASE_RETRY
}

enum EvaluationRunStage {
  QUEUED
  PROCESSING_EVIDENCE
  READY_FOR_SYNTHESIS
  REPORT_ACCEPTED
  SYNTHESIS_EXHAUSTED
}

enum EvaluationExecutionCycleStatus {
  ACTIVE
  READY_FOR_SYNTHESIS
  EXHAUSTED
  COMPLETED
}

enum EvaluationSampleStatus {
  PENDING
  EVIDENCE_ACCEPTED
  INTERPRETATION_ACCEPTED
  ACQUISITION_EXHAUSTED
  INTERPRETATION_EXHAUSTED
}

enum AiExecutionPurpose {
  EVALUATION_ACQUISITION
  EVALUATION_INTERPRETATION
}

enum AiExecutionAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum EvaluationSearchObservation {
  TRIGGERED
  NOT_TRIGGERED
  UNKNOWN
}

enum NotificationKind {
  EVALUATION_COMPLETED
  EVALUATION_RETRY_REQUIRED
}

enum MediaPlatformStatus {
  ACTIVE
  INACTIVE
}

enum MediaCategory {
  CENTRAL_MEDIA
  PORTAL_MEDIA
  LOCAL_MEDIA
  VERTICAL_MEDIA
  CONTENT_PLATFORM
  OVERSEAS_MEDIA
}

enum MediaRegionScope {
  DOMESTIC
  OVERSEAS
}

enum MediaResourceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MediaSupplySourceStatus {
  ACTIVE
  INACTIVE
}

enum MediaPublicationMode {
  FIRST_PUBLISH
  REPOST
}

enum MediaPublicVisibility {
  HIDDEN
  FULL
  MASKED
}

enum MediaQualityTier {
  HIGH
  MEDIUM
  LOW
}

model Account {
  id           String           @id @default(uuid()) @db.Uuid
  mobile       String           @unique @db.VarChar(20)
  role         AccountRole      @default(TERMINAL_CUSTOMER)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  sessions     AccountSession[]
  brands       BrandProfile[]
  brandContext BrandContext?
  notifications Notification[]
  mediaCatalogAudits MediaCatalogAudit[]

  @@map("accounts")
}

model MobileChallenge {
  id             String    @id @db.Uuid
  mobile         String    @db.VarChar(20)
  codeDigest     String    @map("code_digest") @db.Char(64)
  failedAttempts Int       @default(0) @map("failed_attempts")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([mobile, createdAt])
  @@map("mobile_challenges")
}

model AccountSession {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.Char(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("account_sessions")
}

model BrandProfile {
  id                     String                 @id @default(uuid()) @db.Uuid
  accountId              String                 @map("account_id") @db.Uuid
  status                 BrandStatus            @default(ACTIVE)
  companyName            String                 @map("company_name")
  primaryIndustryId      String?                @map("primary_industry_id") @db.VarChar(100)
  secondaryIndustryId    String?                @map("secondary_industry_id") @db.VarChar(100)
  otherProductOrService  String?                @map("other_product_or_service") @db.VarChar(60)
  characteristicOne      String?                @map("characteristic_one")
  characteristicTwo      String?                @map("characteristic_two")
  provinceRegionId       String?                @map("province_region_id") @db.VarChar(100)
  cityRegionId           String?                @map("city_region_id") @db.VarChar(100)
  terminalRegionId       String?                @map("terminal_region_id") @db.VarChar(100)
  contactName            String?                @map("contact_name")
  contactMobile          String?                @map("contact_mobile") @db.VarChar(20)
  evaluationFingerprint  String                 @map("evaluation_fingerprint") @db.Char(64)
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  account                Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  selectedByBrandContext BrandContext?          @relation("CurrentBrand")
  evaluationDefinitions  EvaluationDefinition[] @relation("BrandEvaluationDefinitions")

  @@unique([id, accountId])
  @@index([accountId, status, updatedAt])
  @@map("brand_profiles")
}

model BrandContext {
  accountId      String        @id @map("account_id") @db.Uuid
  currentBrandId String?       @map("current_brand_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentBrand   BrandProfile? @relation("CurrentBrand", fields: [currentBrandId, accountId], references: [id, accountId], onDelete: Restrict)

  @@unique([currentBrandId, accountId])
  @@map("brand_contexts")
}

model EvaluationDefinition {
  id                        String               @id @default(uuid()) @db.Uuid
  accountId                 String               @map("account_id") @db.Uuid
  brandId                   String               @map("brand_id") @db.Uuid
  inputFingerprint          String               @map("input_fingerprint") @db.Char(64)
  brandSnapshot             Json                 @map("brand_snapshot")
  questionGeneratorId       String               @map("question_generator_id")
  questionGeneratorVersion  String               @map("question_generator_version")
  questionGeneratorHash     String               @map("question_generator_hash") @db.Char(64)
  platformPolicy            Json                 @map("platform_policy")
  objectivityProfileId      String               @map("objectivity_profile_id")
  objectivityProfileVersion String               @map("objectivity_profile_version")
  objectivityProfileHash    String               @map("objectivity_profile_hash") @db.Char(64)
  objectivityProfileContent String               @map("objectivity_profile_content")
  createdAt                 DateTime             @default(now()) @map("created_at")
  brand                     BrandProfile         @relation("BrandEvaluationDefinitions", fields: [brandId, accountId], references: [id, accountId], onDelete: Restrict)
  questions                 EvaluationQuestion[]
  run                       EvaluationRun?

  @@unique([brandId, inputFingerprint])
  @@unique([id, accountId, brandId])
  @@index([accountId, brandId, createdAt])
  @@map("evaluation_definitions")
}

model EvaluationQuestion {
  id           String                 @id @default(uuid()) @db.Uuid
  definitionId String                 @map("definition_id") @db.Uuid
  kind         EvaluationQuestionKind
  ordinal      Int
  content      String
  createdAt    DateTime               @default(now()) @map("created_at")
  definition   EvaluationDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  samples      EvaluationSample[]

  @@unique([definitionId, kind])
  @@unique([definitionId, ordinal])
  @@unique([id, definitionId])
  @@map("evaluation_questions")
}

model EvaluationRun {
  id                   String                          @id @default(uuid()) @db.Uuid
  accountId            String                          @map("account_id") @db.Uuid
  brandId              String                          @map("brand_id") @db.Uuid
  definitionId         String                          @unique @map("definition_id") @db.Uuid
  inputFingerprint     String                          @map("input_fingerprint") @db.Char(64)
  status               EvaluationRunStatus             @default(EVALUATING)
  stage                EvaluationRunStage              @default(QUEUED)
  correlationId        String                          @map("correlation_id") @db.Uuid
  startedAt            DateTime                        @default(now()) @map("started_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")
  definition           EvaluationDefinition            @relation(fields: [definitionId, accountId, brandId], references: [id, accountId, brandId], onDelete: Restrict)
  samples              EvaluationSample[]
  executionCycles      EvaluationExecutionCycle[]
  synthesis            EvaluationSynthesis?
  report               EvaluationReport?
  optimizationGuidance EvaluationOptimizationGuidance?

  @@unique([id, definitionId])
  @@unique([definitionId, accountId, brandId])
  @@index([accountId, brandId, startedAt])
  @@map("evaluation_runs")
}

model EvaluationExecutionCycle {
  id                  String                         @id @default(uuid()) @db.Uuid
  runId               String                         @map("run_id") @db.Uuid
  sequence            Int
  status              EvaluationExecutionCycleStatus @default(ACTIVE)
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  run                 EvaluationRun                  @relation(fields: [runId], references: [id], onDelete: Restrict)
  attempts            AiExecutionAttempt[]
  failures            EvaluationStageExhaustion[]
  synthesisAttempts   AiSynthesisAttempt[]
  synthesisExhaustion EvaluationSynthesisExhaustion?

  @@unique([runId, sequence])
  @@unique([id, runId])
  @@index([status, updatedAt])
  @@map("evaluation_execution_cycles")
}

model EvaluationSample {
  id             String                          @id @default(uuid()) @db.Uuid
  runId          String                          @map("run_id") @db.Uuid
  definitionId   String                          @map("definition_id") @db.Uuid
  questionId     String                          @map("question_id") @db.Uuid
  platformKey    String                          @map("platform_key") @db.VarChar(40)
  platformLabel  String                          @map("platform_label") @db.VarChar(80)
  status         EvaluationSampleStatus          @default(PENDING)
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @updatedAt @map("updated_at")
  run            EvaluationRun                   @relation(fields: [runId, definitionId], references: [id, definitionId], onDelete: Restrict)
  question       EvaluationQuestion              @relation(fields: [questionId, definitionId], references: [id, definitionId], onDelete: Restrict)
  attempts       AiExecutionAttempt[]
  evidence       EvaluationSampleEvidence?
  interpretation EvaluationSampleInterpretation?
  failures       EvaluationStageExhaustion[]

  @@unique([runId, questionId, platformKey])
  @@unique([id, runId], map: "evaluation_samples_id_run_key")
  @@index([runId, status])
  @@map("evaluation_samples")
}

model AiExecutionAttempt {
  id                     String                          @id @default(uuid()) @db.Uuid
  runId                  String                          @map("run_id") @db.Uuid
  cycleId                String                          @map("cycle_id") @db.Uuid
  sampleId               String                          @map("sample_id") @db.Uuid
  purpose                AiExecutionPurpose
  attemptNumber          Int                             @map("attempt_number")
  status                 AiExecutionAttemptStatus        @default(STARTED)
  routePolicyId          String                          @map("route_policy_id")
  providerKey            String                          @map("provider_key") @db.VarChar(80)
  requestedModel         String                          @map("requested_model") @db.VarChar(120)
  requestPayload         Json                            @map("request_payload")
  responseEnvelope       Json?                           @map("response_envelope")
  failureClass           String?                         @map("failure_class") @db.VarChar(120)
  retryable              Boolean?
  latencyMs              Int?                            @map("latency_ms")
  usage                  Json?
  correlationId          String                          @map("correlation_id") @db.Uuid
  startedAt              DateTime                        @default(now()) @map("started_at")
  finishedAt             DateTime?                       @map("finished_at")
  cycle                  EvaluationExecutionCycle        @relation(fields: [cycleId, runId], references: [id, runId], onDelete: Restrict, map: "ai_exec_attempt_cycle_run_fkey")
  sample                 EvaluationSample                @relation(fields: [sampleId, runId], references: [id, runId], onDelete: Restrict, map: "ai_exec_attempt_sample_run_fkey")
  acceptedEvidence       EvaluationSampleEvidence?       @relation("AcceptedEvidenceAttempt")
  acceptedInterpretation EvaluationSampleInterpretation? @relation("AcceptedInterpretationAttempt")
  exhaustedStage         EvaluationStageExhaustion?      @relation("ExhaustedStageAttempt")

  @@unique([cycleId, sampleId, purpose, attemptNumber], map: "ai_exec_attempt_cycle_sample_purpose_number_key")
  @@unique([id, sampleId])
  @@unique([id, cycleId, sampleId, runId], map: "ai_exec_attempt_exhaustion_identity_key")
  @@index([cycleId, purpose, status])
  @@map("ai_execution_attempts")
}

model EvaluationSampleEvidence {
  id                String             @id @default(uuid()) @db.Uuid
  sampleId          String             @unique @map("sample_id") @db.Uuid
  acceptedAttemptId String             @unique @map("accepted_attempt_id") @db.Uuid
  answerContent     String             @map("answer_content")
  answerFormat      String             @map("answer_format") @db.VarChar(40)
  sourceMetadata    Json               @map("source_metadata")
  searchObservation EvaluationSearchObservation @map("search_observation")
  returnedModel     String             @map("returned_model") @db.VarChar(120)
  acceptedAt        DateTime           @default(now()) @map("accepted_at")
  sample            EvaluationSample   @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  acceptedAttempt   AiExecutionAttempt @relation("AcceptedEvidenceAttempt", fields: [acceptedAttemptId, sampleId], references: [id, sampleId], onDelete: Restrict)

  @@unique([acceptedAttemptId, sampleId])
  @@map("evaluation_sample_evidence")
}

model EvaluationSampleInterpretation {
  id                      String             @id @default(uuid()) @db.Uuid
  sampleId                String             @unique @map("sample_id") @db.Uuid
  acceptedAttemptId       String             @unique @map("accepted_attempt_id") @db.Uuid
  mentioned               Boolean
  position                Int?
  semanticContractVersion String             @map("semantic_contract_version") @db.VarChar(40)
  semanticPayload         Json               @map("semantic_payload")
  relevantDescription     String?            @map("relevant_description")
  characteristics         Json?
  objectiveSummary        String?            @map("objective_summary")
  structuredEvidence      Json?              @map("structured_evidence")
  acceptedAt              DateTime           @default(now()) @map("accepted_at")
  sample                  EvaluationSample   @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  acceptedAttempt         AiExecutionAttempt @relation("AcceptedInterpretationAttempt", fields: [acceptedAttemptId, sampleId], references: [id, sampleId], onDelete: Restrict)

  @@unique([acceptedAttemptId, sampleId])
  @@map("evaluation_sample_interpretations")
}

model EvaluationStageExhaustion {
  id            String                   @id @default(uuid()) @db.Uuid
  runId         String                   @map("run_id") @db.Uuid
  cycleId       String                   @map("cycle_id") @db.Uuid
  sampleId      String                   @map("sample_id") @db.Uuid
  purpose       AiExecutionPurpose
  lastAttemptId String                   @map("last_attempt_id") @db.Uuid
  failureClass  String                   @map("failure_class") @db.VarChar(120)
  reason        String
  createdAt     DateTime                 @default(now()) @map("created_at")
  cycle         EvaluationExecutionCycle @relation(fields: [cycleId, runId], references: [id, runId], onDelete: Restrict, map: "eval_stage_exhaust_cycle_run_fkey")
  sample        EvaluationSample         @relation(fields: [sampleId, runId], references: [id, runId], onDelete: Restrict, map: "eval_stage_exhaust_sample_run_fkey")
  lastAttempt   AiExecutionAttempt       @relation("ExhaustedStageAttempt", fields: [lastAttemptId, cycleId, sampleId, runId], references: [id, cycleId, sampleId, runId], onDelete: Restrict, map: "eval_stage_exhaust_attempt_identity_fkey")

  @@unique([cycleId, sampleId, purpose], map: "eval_stage_exhaust_cycle_sample_purpose_key")
  @@unique([lastAttemptId, cycleId, sampleId, runId], map: "eval_stage_exhaust_attempt_identity_key")
  @@index([cycleId, purpose])
  @@map("evaluation_stage_exhaustions")
}

model AiSynthesisAttempt {
  id                 String                         @id @default(uuid()) @db.Uuid
  runId              String                         @map("run_id") @db.Uuid
  cycleId            String                         @map("cycle_id") @db.Uuid
  attemptNumber      Int                            @map("attempt_number")
  status             AiExecutionAttemptStatus       @default(STARTED)
  routePolicyId      String                         @map("route_policy_id")
  providerKey        String                         @map("provider_key") @db.VarChar(80)
  requestedModel     String                         @map("requested_model") @db.VarChar(120)
  requestPayload     Json                           @map("request_payload")
  responseEnvelope   Json?                          @map("response_envelope")
  failureClass       String?                        @map("failure_class") @db.VarChar(120)
  retryable          Boolean?
  latencyMs          Int?                           @map("latency_ms")
  usage              Json?
  correlationId      String                         @map("correlation_id") @db.Uuid
  startedAt          DateTime                       @default(now()) @map("started_at")
  finishedAt         DateTime?                      @map("finished_at")
  cycle              EvaluationExecutionCycle       @relation(fields: [cycleId, runId], references: [id, runId], onDelete: Restrict, map: "ai_synth_attempt_cycle_run_fkey")
  acceptedSynthesis  EvaluationSynthesis?           @relation("AcceptedOverallSynthesisAttempt")
  exhaustedSynthesis EvaluationSynthesisExhaustion? @relation("ExhaustedOverallSynthesisAttempt")

  @@unique([cycleId, attemptNumber], map: "ai_synth_attempt_cycle_number_key")
  @@unique([id, runId], map: "ai_synth_attempt_id_run_key")
  @@index([runId, status])
  @@map("ai_synthesis_attempts")
}

model EvaluationSynthesis {
  id                      String                          @id @default(uuid()) @db.Uuid
  runId                   String                          @unique @map("run_id") @db.Uuid
  acceptedAttemptId       String                          @unique @map("accepted_attempt_id") @db.Uuid
  semanticContractVersion String                          @map("semantic_contract_version") @db.VarChar(60)
  semanticPayload         Json                            @map("semantic_payload")
  acceptedAt              DateTime                        @default(now()) @map("accepted_at")
  run                     EvaluationRun                   @relation(fields: [runId], references: [id], onDelete: Restrict)
  acceptedAttempt         AiSynthesisAttempt              @relation("AcceptedOverallSynthesisAttempt", fields: [acceptedAttemptId, runId], references: [id, runId], onDelete: Restrict, map: "eval_synthesis_attempt_run_fkey")
  report                  EvaluationReport?
  optimizationGuidance    EvaluationOptimizationGuidance?

  @@unique([id, runId], map: "eval_synthesis_id_run_key")
  @@unique([acceptedAttemptId, runId], map: "eval_synthesis_attempt_run_key")
  @@map("evaluation_syntheses")
}

model EvaluationReport {
  id                      String              @id @default(uuid()) @db.Uuid
  runId                   String              @unique @map("run_id") @db.Uuid
  synthesisId             String              @unique @map("synthesis_id") @db.Uuid
  metricPolicyVersion     String              @map("metric_policy_version") @db.VarChar(60)
  documentContractVersion String              @map("document_contract_version") @db.VarChar(60)
  publicDocument          Json                @map("public_document")
  acceptedAt              DateTime            @default(now()) @map("accepted_at")
  run                     EvaluationRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  synthesis               EvaluationSynthesis @relation(fields: [synthesisId, runId], references: [id, runId], onDelete: Restrict, map: "eval_report_synthesis_run_fkey")

  @@unique([synthesisId, runId], map: "eval_report_synthesis_run_key")
  @@map("evaluation_reports")
}

model EvaluationOptimizationGuidance {
  id              String              @id @default(uuid()) @db.Uuid
  runId           String              @unique @map("run_id") @db.Uuid
  synthesisId     String              @unique @map("synthesis_id") @db.Uuid
  guidancePayload Json                @map("guidance_payload")
  acceptedAt      DateTime            @default(now()) @map("accepted_at")
  run             EvaluationRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  synthesis       EvaluationSynthesis @relation(fields: [synthesisId, runId], references: [id, runId], onDelete: Restrict, map: "eval_guidance_synthesis_run_fkey")

  @@unique([synthesisId, runId], map: "eval_guidance_synthesis_run_key")
  @@map("evaluation_optimization_guidance")
}

model EvaluationSynthesisExhaustion {
  id            String                   @id @default(uuid()) @db.Uuid
  runId         String                   @map("run_id") @db.Uuid
  cycleId       String                   @unique @map("cycle_id") @db.Uuid
  lastAttemptId String                   @unique @map("last_attempt_id") @db.Uuid
  failureClass  String                   @map("failure_class") @db.VarChar(120)
  reason        String
  createdAt     DateTime                 @default(now()) @map("created_at")
  cycle         EvaluationExecutionCycle @relation(fields: [cycleId, runId], references: [id, runId], onDelete: Restrict, map: "eval_synth_exhaust_cycle_run_fkey")
  lastAttempt   AiSynthesisAttempt       @relation("ExhaustedOverallSynthesisAttempt", fields: [lastAttemptId, runId], references: [id, runId], onDelete: Restrict, map: "eval_synth_exhaust_attempt_run_fkey")

  @@unique([lastAttemptId, runId], map: "eval_synth_exhaust_attempt_run_key")
  @@unique([cycleId, runId], map: "eval_synth_exhaust_cycle_run_key")
  @@index([runId])
  @@map("evaluation_synthesis_exhaustions")
}

model ProductOutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  businessKey   String       @unique @map("business_key")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  correlationId String       @map("correlation_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  dispatchedAt  DateTime?    @map("dispatched_at")
  completedAt   DateTime?    @map("completed_at")

  @@index([status, createdAt])
  @@map("product_outbox_events")
}

model Notification {
  id                 String           @id @default(uuid()) @db.Uuid
  recipientAccountId String           @map("recipient_account_id") @db.Uuid
  sourceEventId      String           @unique @map("source_event_id") @db.Uuid
  kind               NotificationKind
  title              String           @db.VarChar(120)
  summary            String           @db.VarChar(320)
  target             Json
  occurredAt         DateTime         @map("occurred_at")
  readAt             DateTime?        @map("read_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  recipient          Account          @relation(fields: [recipientAccountId], references: [id], onDelete: Cascade)

  @@index([recipientAccountId, createdAt, id])
  @@index([recipientAccountId, readAt])
  @@map("notifications")
}

model MediaPlatform {
  id             String              @id @default(uuid()) @db.Uuid
  normalizedName String              @unique @map("normalized_name") @db.VarChar(160)
  displayName    String              @map("display_name") @db.VarChar(160)
  aliases        String[]            @default([])
  description    String?
  logoUrl        String?             @map("logo_url") @db.VarChar(2048)
  regionScope    MediaRegionScope    @default(DOMESTIC) @map("region_scope")
  status         MediaPlatformStatus @default(INACTIVE)
  pointPrice     Int?                @map("point_price")
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  categories     MediaPlatformCategory[]
  resources      MediaResource[]

  @@index([status, displayName, id])
  @@map("media_platforms")
}

model MediaPlatformCategory {
  platformId String        @map("platform_id") @db.Uuid
  category   MediaCategory
  platform   MediaPlatform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  @@id([platformId, category])
  @@index([category, platformId])
  @@map("media_platform_categories")
}

model MediaSupplySource {
  id            String                  @id @default(uuid()) @db.Uuid
  name          String                  @db.VarChar(160)
  contactName   String?                 @map("contact_name") @db.VarChar(160)
  contactMethod String?                 @map("contact_method") @db.VarChar(320)
  status        MediaSupplySourceStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  resources     MediaResource[]

  @@index([status, name, id])
  @@map("media_supply_sources")
}

model MediaResource {
  id                 String                @id @default(uuid()) @db.Uuid
  platformId         String                @map("platform_id") @db.Uuid
  supplySourceId     String                @map("supply_source_id") @db.Uuid
  resourceName       String                @map("resource_name") @db.VarChar(240)
  accountIdentifier  String?               @map("account_identifier") @db.VarChar(240)
  accountUrl         String?               @map("account_url") @db.VarChar(2048)
  publicationMode    MediaPublicationMode  @default(FIRST_PUBLISH) @map("publication_mode")
  status             MediaResourceStatus   @default(ACTIVE)
  publicVisibility   MediaPublicVisibility @default(HIDDEN) @map("public_visibility")
  publicAlias        String?               @map("public_alias") @db.VarChar(240)
  qualityTier        MediaQualityTier      @default(MEDIUM) @map("quality_tier")
  procurementCostFen Int?                  @map("procurement_cost_fen")
  caseUrl            String?               @map("case_url") @db.VarChar(2048)
  publicationNotes   String?               @map("publication_notes")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  platform           MediaPlatform         @relation(fields: [platformId], references: [id], onDelete: Restrict)
  supplySource       MediaSupplySource     @relation(fields: [supplySourceId], references: [id], onDelete: Restrict)

  @@index([platformId, status, publicVisibility, qualityTier, id])
  @@index([supplySourceId, status, id])
  @@map("media_resources")
}

model MediaCatalogState {
  id             String   @id @db.VarChar(32)
  publicRevision BigInt   @default(1) @map("public_revision")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("media_catalog_state")
}

model MediaCatalogAudit {
  id             String   @id @default(uuid()) @db.Uuid
  actorAccountId String   @map("actor_account_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.Uuid
  action         String   @db.VarChar(80)
  reason         String   @db.VarChar(320)
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  createdAt      DateTime @default(now()) @map("created_at")
  actor          Account  @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorAccountId, createdAt])
  @@map("media_catalog_audits")
}

model FoundationRecord {
  id            String                 @id @default(uuid()) @db.Uuid
  name          String
  status        FoundationRecordStatus @default(ACCEPTED)
  correlationId String                 @map("correlation_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  outboxEvents  OutboxEvent[]
  effects       WorkEffect[]

  @@map("foundation_records")
}

model OutboxEvent {
  id            String           @id @default(uuid()) @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  eventType     String           @map("event_type")
  payload       Json
  status        OutboxStatus     @default(PENDING)
  correlationId String           @map("correlation_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  completedAt   DateTime?        @map("completed_at")
  record        FoundationRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  effect        WorkEffect?

  @@index([status, updatedAt])
  @@map("outbox_events")
}

model WorkEffect {
  id            String           @id @default(uuid()) @db.Uuid
  businessKey   String           @unique @map("business_key")
  outboxEventId String           @unique @map("outbox_event_id") @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  result        String
  correlationId String           @map("correlation_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  outboxEvent   OutboxEvent      @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  record        FoundationRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@map("work_effects")
}
