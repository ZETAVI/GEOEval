// Recharge owns authenticated notification facts; no local order or points claim.
model RechargePaymentObservation {
  sourceKind            String                        @default("NOTIFICATION") @map("source_kind") @db.VarChar(16)
  queryKey              String?                       @unique @map("query_key") @db.VarChar(64)
  queriedOrderId        String?                       @map("queried_order_id") @db.Uuid
  queriedOrder          RechargeOrder?                @relation("RechargeQuerySource", fields: [queriedOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paidOrders            RechargeOrder[]               @relation("RechargePaidSource")
  id                    String                        @id @default(uuid()) @db.Uuid
  provider              String                        @db.VarChar(16)
  merchantId            String                        @map("merchant_id") @db.VarChar(128)
  notificationId        String?                       @map("notification_id") @db.VarChar(128)
  factsSha256           String                        @map("facts_sha256") @db.VarChar(64)
  factsVersion          Int                           @map("facts_version")
  observationState      String                        @default("SUCCESS") @map("observation_state") @db.VarChar(32)
  providerState         String                        @default("SUCCESS") @map("provider_state") @db.VarChar(32)
  appId                 String                        @map("app_id") @db.VarChar(128)
  merchantOrderNo       String                        @map("merchant_order_no") @db.VarChar(128)
  transactionId         String?                       @map("transaction_id") @db.VarChar(128)
  tradeType             String?                       @map("trade_type") @db.VarChar(16)
  orderTotalFen         BigInt                        @map("order_total_fen")
  currency              String                        @db.VarChar(3)
  payerTotalFen         BigInt?                       @map("payer_total_fen")
  payerCurrency         String?                       @map("payer_currency") @db.VarChar(3)
  successAt             DateTime?                     @map("success_at") @db.Timestamptz(3)
  sellerTransferAt      DateTime?                     @map("seller_transfer_at") @db.Timestamptz(3)
  notificationCreatedAt DateTime?                     @map("notification_created_at") @db.Timestamptz(3)
  proofKind             String                        @default("WECHAT_V3") @map("proof_kind") @db.VarChar(32)
  sdkVersion            String?                       @map("sdk_version") @db.VarChar(32)
  verificationKeyId     String                        @map("verification_key_id") @db.VarChar(128)
  signedAtSeconds       BigInt?                       @map("signed_at_seconds")
  receivedAt            DateTime                      @map("received_at") @db.Timestamptz(3)
  bodySha256            String?                       @map("body_sha256") @db.VarChar(64)
  requestSha256         String?                       @map("request_sha256") @db.VarChar(64)
  responseDataSha256    String?                       @map("response_data_sha256") @db.VarChar(64)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  receipts              RechargeNotificationReceipt[]
  nativeAttempts        RechargeOperationAttempt[]

  @@unique([provider, merchantId, notificationId, factsSha256], map: "recharge_observation_facts_key")
  @@map("recharge_payment_observations")
}

model RechargeNotificationReceipt {
