generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoundationRecordStatus {
  ACCEPTED
  PROCESSED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  COMPLETED
}

enum AccountRole {
  TERMINAL_CUSTOMER
  OPERATIONS
  ADMINISTRATOR
  AGENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum SessionRevocationReason {
  USER_LOGOUT
  USER_LOGOUT_ALL
  ADMIN_REVOKE_ALL
  ACCOUNT_DEACTIVATED
  ROLE_CHANGED
}

enum IdentityGovernanceActorKind {
  ACCOUNT
  BOOTSTRAP
}

enum IdentityGovernanceAction {
  BOOTSTRAP_ADMINISTRATOR
  CREATE_INTERNAL_ACCOUNT
  ACTIVATE_ACCOUNT
  DEACTIVATE_ACCOUNT
  CHANGE_INTERNAL_ROLE
  REVOKE_ACCOUNT_SESSIONS
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum BrandStoreLocationProvider {
  AMAP
}

enum BrandQueryLocalityKind {
  BUSINESS_AREA
  ADDRESS_LOCALITY
}

enum EvaluationQuestionKind {
  BRAND_DIRECTED
  INDUSTRY_RECOMMENDATION
  CHARACTERISTIC_ONE
  CHARACTERISTIC_TWO
}

enum EvaluationQuestionPreparationStatus {
  PREPARING
  READY
  PLEASE_RETRY
}

enum EvaluationRunStatus {
  EVALUATING
  COMPLETED
  PLEASE_RETRY
}

enum EvaluationRunStage {
  QUEUED
  PROCESSING_EVIDENCE
  READY_FOR_SYNTHESIS
  REPORT_ACCEPTED
  SYNTHESIS_EXHAUSTED
}

enum EvaluationExecutionCycleStatus {
  ACTIVE
  READY_FOR_SYNTHESIS
  EXHAUSTED
  COMPLETED
}

enum EvaluationSampleStatus {
  PENDING
  EVIDENCE_ACCEPTED
  INTERPRETATION_ACCEPTED
  ACQUISITION_EXHAUSTED
  INTERPRETATION_EXHAUSTED
}

enum AiExecutionPurpose {
  EVALUATION_ACQUISITION
  EVALUATION_INTERPRETATION
}

enum AiExecutionAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum EvaluationAggregateAnalysisPurpose {
  OVERALL_SYNTHESIS
  BRAND_NAME_RESOLUTION
  REPORT_COMPOSITION
}

enum EvaluationSearchObservation {
  TRIGGERED
  NOT_TRIGGERED
  UNKNOWN
}

enum ArticleGenerationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  NOT_APPLIED
}

enum CoreArticleStatus {
  DRAFT
  CONFIRMED
}

enum NotificationKind {
  EVALUATION_COMPLETED
  EVALUATION_RETRY_REQUIRED
  RECHARGE_SUCCESSFUL
}

enum MediaPlatformStatus {
  ACTIVE
  INACTIVE
}

enum MediaCategory {
  CENTRAL_MEDIA
  PORTAL_MEDIA
  LOCAL_MEDIA
  VERTICAL_MEDIA
  CONTENT_PLATFORM
}

enum MediaRegionScope {
  DOMESTIC
  OVERSEAS
}

enum MediaResourceStatus {
  ACTIVE
  INACTIVE
}

enum MediaSupplierStatus {
  ACTIVE
  INACTIVE
}

enum MediaPublicationMode {
  FIRST_PUBLISH
  REPOST
}

enum MediaPublicVisibility {
  HIDDEN
  FULL
  MASKED
}

enum MediaQualityTier {
  HIGH
  MEDIUM
  LOW
}

model Account {
  supportTickets SupportTicket[] @relation("SupportCustomer")
  supportAssignments SupportTicket[] @relation("SupportAssignee")
  supportEvents SupportEvent[]

  commissionTerms       AgencyCommissionTerms?
  commissionAudits      AgencyCommissionAudit[] @relation("CommissionAgent")
  commissionAuditsActed AgencyCommissionAudit[] @relation("CommissionActor")
  agencyOrderTerms      PublishingOrderAgency[]

  agencyAuditsBefore        AgencyAudit[]                   @relation("AgencyAuditBefore")
  agencyLinks               AgencyEntryLink[]               @relation("AgencyLinkAgent")
  agencyCustomerSource      AgencyCustomerAttribution?      @relation("AgencyCustomerAccount")
  agencyCustomers           AgencyCustomerAttribution[]     @relation("AgencyCustomerAgent")
  agencyChallenges          AgencyChallengeAttribution[]    @relation("AgencyChallengeAgent")
  agencyAuditsActed         AgencyAudit[]                   @relation("AgencyAuditActor")
  agencyAuditsTargeted      AgencyAudit[]                   @relation("AgencyAuditTarget")
  agencyAuditsAgent         AgencyAudit[]                   @relation("AgencyAuditAgent")
  recharges                 RechargeOrder[]
  id                        String                          @id @default(uuid()) @db.Uuid
  mobile                    String                          @unique @db.VarChar(20)
  role                      AccountRole                     @default(TERMINAL_CUSTOMER)
  status                    AccountStatus                   @default(ACTIVE)
  revision                  Int                             @default(1)
  lastAuthenticatedAt       DateTime?                       @map("last_authenticated_at")
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  sessions                  AccountSession[]
  brands                    BrandProfile[]
  brandContext              BrandContext?
  notifications             Notification[]
  mediaCatalogAudits        MediaCatalogAudit[]
  publishingPackageAudits   PublishingPackageAudit[]
  pointAccount              PointAccount?
  pointChangesActed         PointChange[]
  publicationDeliveries     PublicationDelivery[]           @relation("DeliveryAssignee")
  publicationDeliveryAudits PublicationDeliveryAudit[]
  publicationWorkAudits     PublicationWorkAudit[]
  questionPreparations      EvaluationQuestionPreparation[]
  identityAuditsActed       IdentityGovernanceAudit[]       @relation("IdentityAuditActor")
  identityAuditsTargeted    IdentityGovernanceAudit[]       @relation("IdentityAuditTarget")
  bootstrapGovernanceState  IdentityGovernanceControl?      @relation("BootstrapAccount")

  @@index([role, status, createdAt, id])
  @@index([status, updatedAt, id])
  @@map("accounts")
}

model MobileChallenge {
  existingAccountOnly Boolean                     @default(false) @map("existing_account_only")
  agencySource        AgencyChallengeAttribution?
  id                  String                      @id @db.Uuid
  mobile              String                      @db.VarChar(20)
  codeDigest          String                      @map("code_digest") @db.Char(64)
  failedAttempts      Int                         @default(0) @map("failed_attempts")
  expiresAt           DateTime                    @map("expires_at")
  consumedAt          DateTime?                   @map("consumed_at")
  supersededAt        DateTime?                   @map("superseded_at")
  createdAt           DateTime                    @default(now()) @map("created_at")

  @@index([mobile, createdAt])
  @@map("mobile_challenges")
}

model MobileChallengeRateLimit {
  mobile          String   @id @db.VarChar(20)
  windowStartedAt DateTime @map("window_started_at")
  requestCount    Int      @default(0) @map("request_count")
  lastIssuedAt    DateTime @map("last_issued_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([lastIssuedAt])
  @@map("mobile_challenge_rate_limits")
}

model AccountSession {
  id            String                   @id @default(uuid()) @db.Uuid
  accountId     String                   @map("account_id") @db.Uuid
  tokenDigest   String                   @unique @map("token_digest") @db.Char(64)
  expiresAt     DateTime                 @map("expires_at")
  idleExpiresAt DateTime                 @default(dbgenerated("(CURRENT_TIMESTAMP + '00:30:00'::interval)")) @map("idle_expires_at")
  lastSeenAt    DateTime                 @default(now()) @map("last_seen_at")
  revokedAt     DateTime?                @map("revoked_at")
  revokedReason SessionRevocationReason? @map("revoked_reason")
  createdAt     DateTime                 @default(now()) @map("created_at")
  account       Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([idleExpiresAt])
  @@map("account_sessions")
}

model IdentityGovernanceControl {
  id                    String    @id @db.VarChar(32)
  bootstrapAccountId    String?   @unique @map("bootstrap_account_id") @db.Uuid
  bootstrapSecretDigest String?   @map("bootstrap_secret_digest") @db.Char(64)
  bootstrapKeyId        String?   @map("bootstrap_key_id") @db.VarChar(120)
  bootstrapCompletedAt  DateTime? @map("bootstrap_completed_at")
  revision              Int       @default(1)
  updatedAt             DateTime  @updatedAt @map("updated_at")
  bootstrapAccount      Account?  @relation("BootstrapAccount", fields: [bootstrapAccountId], references: [id], onDelete: Restrict)

  @@map("identity_governance_controls")
}

model IdentityGovernanceAudit {
  id              String                      @id @default(uuid()) @db.Uuid
  actorKind       IdentityGovernanceActorKind @map("actor_kind")
  actorAccountId  String?                     @map("actor_account_id") @db.Uuid
  actorKeyId      String?                     @map("actor_key_id") @db.VarChar(120)
  targetAccountId String                      @map("target_account_id") @db.Uuid
  action          IdentityGovernanceAction
  reason          String                      @db.VarChar(320)
  beforeState     Json?                       @map("before_state")
  afterState      Json                        @map("after_state")
  createdAt       DateTime                    @default(now()) @map("created_at")
  actor           Account?                    @relation("IdentityAuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict)
  target          Account                     @relation("IdentityAuditTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)

  @@index([targetAccountId, createdAt, id])
  @@index([actorAccountId, createdAt, id])
  @@index([action, createdAt, id])
  @@map("identity_governance_audits")
}

model BrandProfile {
  id                        String                          @id @default(uuid()) @db.Uuid
  accountId                 String                          @map("account_id") @db.Uuid
  status                    BrandStatus                     @default(ACTIVE)
  companyName               String                          @map("company_name")
  primaryIndustryId         String?                         @map("primary_industry_id") @db.VarChar(100)
  secondaryIndustryId       String?                         @map("secondary_industry_id") @db.VarChar(100)
  otherProductOrService     String?                         @map("other_product_or_service") @db.VarChar(60)
  flagshipProductOrService  String?                         @map("flagship_product_or_service") @db.VarChar(80)
  characteristics           Json                            @default("[]")
  contactName               String?                         @map("contact_name")
  contactMobile             String?                         @map("contact_mobile") @db.VarChar(20)
  evaluationFingerprint     String                          @map("evaluation_fingerprint") @db.Char(64)
  writingContextFingerprint String                          @map("writing_context_fingerprint") @db.Char(64)
  articleInformation        Json                            @default("{\"price\":null,\"suitableAudienceContexts\":[],\"supplementalBackground\":null,\"desiredPositioning\":[]}") @map("article_information")
  revision                  Int                             @default(1)
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  account                   Account                         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  selectedByBrandContext    BrandContext?                   @relation("CurrentBrand")
  evaluationDefinitions     EvaluationDefinition[]          @relation("BrandEvaluationDefinitions")
  questionPreparations      EvaluationQuestionPreparation[] @relation("BrandQuestionPreparations")
  storeLocation             BrandStoreLocation?
  writerInputSnapshots      WriterInputSnapshot[]           @relation("BrandWriterInputSnapshots")
  articleGenerations        ArticleGeneration[]             @relation("BrandArticleGenerations")
  coreArticle               CoreArticle?                    @relation("BrandCoreArticle")

  @@unique([id, accountId])
  @@index([accountId, status, updatedAt])
  @@map("brand_profiles")
}

model BrandStoreLocation {
  id                            String                     @id @default(uuid()) @db.Uuid
  brandId                       String                     @unique @map("brand_id") @db.Uuid
  accountId                     String                     @map("account_id") @db.Uuid
  semanticFactId                String                     @map("semantic_fact_id") @db.Uuid
  verificationId                String                     @unique @map("verification_id") @db.Uuid
  receiptIssuedAt               DateTime                   @map("receipt_issued_at")
  searchInput                   String                     @map("search_input") @db.VarChar(200)
  provider                      BrandStoreLocationProvider
  providerPlaceId               String                     @map("provider_place_id") @db.VarChar(120)
  providerContractVersion       String                     @map("provider_contract_version") @db.VarChar(100)
  verifiedAt                    DateTime                   @map("verified_at")
  placeName                     String                     @map("place_name") @db.VarChar(240)
  formattedAddress              String                     @map("formatted_address") @db.VarChar(500)
  provinceName                  String                     @map("province_name") @db.VarChar(100)
  cityName                      String?                    @map("city_name") @db.VarChar(100)
  districtName                  String?                    @map("district_name") @db.VarChar(100)
  townshipName                  String?                    @map("township_name") @db.VarChar(100)
  providerAdcode                String                     @map("provider_adcode") @db.VarChar(12)
  providerTowncode              String?                    @map("provider_towncode") @db.VarChar(16)
  officialProvinceRegionId      String                     @map("official_province_region_id") @db.VarChar(100)
  officialCityRegionId          String                     @map("official_city_region_id") @db.VarChar(100)
  officialTerminalRegionId      String                     @map("official_terminal_region_id") @db.VarChar(100)
  officialRegionPath            Json                       @map("official_region_path")
  officialRegionSourceReleaseId String                     @map("official_region_source_release_id") @db.VarChar(100)
  longitude                     Decimal                    @db.Decimal(9, 6)
  latitude                      Decimal                    @db.Decimal(9, 6)
  coordinateSystem              String                     @map("coordinate_system") @db.VarChar(20)
  queryLocalityKind             BrandQueryLocalityKind     @map("query_locality_kind")
  queryLocalityLabel            String                     @map("query_locality_label") @db.VarChar(240)
  createdAt                     DateTime                   @default(now()) @map("created_at")
  updatedAt                     DateTime                   @updatedAt @map("updated_at")
  brand                         BrandProfile               @relation(fields: [brandId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([brandId, accountId])
  @@index([accountId])
  @@map("brand_store_locations")
}

model BrandContext {
  accountId      String        @id @map("account_id") @db.Uuid
  currentBrandId String?       @map("current_brand_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currentBrand   BrandProfile? @relation("CurrentBrand", fields: [currentBrandId, accountId], references: [id, accountId], onDelete: Restrict)

  @@unique([currentBrandId, accountId])
  @@map("brand_contexts")
}

model EvaluationDefinition {
  id                                  String                         @id @default(uuid()) @db.Uuid
  accountId                           String                         @map("account_id") @db.Uuid
  brandId                             String                         @map("brand_id") @db.Uuid
  inputFingerprint                    String                         @map("input_fingerprint") @db.Char(64)
  brandSnapshot                       Json                           @map("brand_snapshot")
  questionGeneratorId                 String                         @map("question_generator_id")
  questionGeneratorVersion            String                         @map("question_generator_version")
  questionGeneratorHash               String                         @map("question_generator_hash") @db.Char(64)
  platformPolicy                      Json                           @map("platform_policy")
  objectivityProfileId                String                         @map("objectivity_profile_id")
  objectivityProfileVersion           String                         @map("objectivity_profile_version")
  objectivityProfileHash              String                         @map("objectivity_profile_hash") @db.Char(64)
  objectivityProfileContent           String                         @map("objectivity_profile_content")
  questionPreparationId               String?                        @unique @map("question_preparation_id") @db.Uuid
  acceptedQuestionGenerationAttemptId String?                        @unique @map("accepted_question_generation_attempt_id") @db.Uuid
  createdAt                           DateTime                       @default(now()) @map("created_at")
  brand                               BrandProfile                   @relation("BrandEvaluationDefinitions", fields: [brandId, accountId], references: [id, accountId], onDelete: Restrict)
  questionPreparation                 EvaluationQuestionPreparation? @relation("AcceptedQuestionDefinition", fields: [questionPreparationId, accountId, brandId], references: [id, accountId, brandId], onDelete: Restrict, map: "eval_definition_preparation_owner_fkey")
  acceptedQuestionGenerationAttempt   AiQuestionGenerationAttempt?   @relation("AcceptedQuestionGenerationAttempt", fields: [acceptedQuestionGenerationAttemptId, questionPreparationId], references: [id, preparationId], onDelete: Restrict, map: "eval_definition_question_attempt_fkey")
  questions                           EvaluationQuestion[]
  run                                 EvaluationRun?

  @@unique([brandId, inputFingerprint])
  @@unique([id, accountId, brandId])
  @@unique([questionPreparationId, accountId, brandId], map: "eval_definition_preparation_owner_key")
  @@unique([acceptedQuestionGenerationAttemptId, questionPreparationId], map: "eval_definition_question_attempt_key")
  @@index([accountId, brandId, createdAt])
  @@map("evaluation_definitions")
}

model EvaluationQuestionPreparation {
  id                    String                              @id @default(uuid()) @db.Uuid
  accountId             String                              @map("account_id") @db.Uuid
  brandId               String                              @map("brand_id") @db.Uuid
  inputFingerprint      String                              @map("input_fingerprint") @db.Char(64)
  brandSnapshot         Json                                @map("brand_snapshot")
  status                EvaluationQuestionPreparationStatus @default(PREPARING)
  currentSequence       Int                                 @default(1) @map("current_sequence")
  instructionId         String                              @map("instruction_id")
  instructionVersion    String                              @map("instruction_version")
  instructionHash       String                              @map("instruction_hash") @db.Char(64)
  instructionContent    String                              @map("instruction_content")
  outputContractVersion String                              @map("output_contract_version")
  outputContractSchema  Json                                @map("output_contract_schema")
  correlationId         String                              @map("correlation_id") @db.Uuid
  createdAt             DateTime                            @default(now()) @map("created_at")
  updatedAt             DateTime                            @updatedAt @map("updated_at")
  account               Account                             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  brand                 BrandProfile                        @relation("BrandQuestionPreparations", fields: [brandId, accountId], references: [id, accountId], onDelete: Restrict)
  attempts              AiQuestionGenerationAttempt[]
  definition            EvaluationDefinition?               @relation("AcceptedQuestionDefinition")

  @@unique([brandId, inputFingerprint])
  @@unique([id, accountId, brandId])
  @@index([status, updatedAt])
  @@index([accountId, brandId, createdAt])
  @@map("evaluation_question_preparations")
}

model AiQuestionGenerationAttempt {
  id                 String                        @id @default(uuid()) @db.Uuid
  preparationId      String                        @map("preparation_id") @db.Uuid
  sequence           Int
  attemptNumber      Int                           @map("attempt_number")
  status             AiExecutionAttemptStatus      @default(STARTED)
  routePolicyId      String                        @map("route_policy_id")
  providerKey        String                        @map("provider_key") @db.VarChar(80)
  requestedModel     String                        @map("requested_model") @db.VarChar(120)
  requestPayload     Json                          @map("request_payload")
  responseEnvelope   Json?                         @map("response_envelope")
  failureClass       String?                       @map("failure_class") @db.VarChar(120)
  retryable          Boolean?
  latencyMs          Int?                          @map("latency_ms")
  usage              Json?
  correlationId      String                        @map("correlation_id") @db.Uuid
  startedAt          DateTime                      @default(now()) @map("started_at")
  finishedAt         DateTime?                     @map("finished_at")
  preparation        EvaluationQuestionPreparation @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  acceptedDefinition EvaluationDefinition?         @relation("AcceptedQuestionGenerationAttempt")

  @@unique([preparationId, sequence, attemptNumber], map: "ai_question_attempt_prep_sequence_number_key")
  @@unique([id, preparationId], map: "ai_question_attempt_id_prep_key")
  @@index([preparationId, sequence, status])
  @@map("ai_question_generation_attempts")
}

model EvaluationQuestion {
  id           String                 @id @default(uuid()) @db.Uuid
  definitionId String                 @map("definition_id") @db.Uuid
  kind         EvaluationQuestionKind
  ordinal      Int
  content      String
  createdAt    DateTime               @default(now()) @map("created_at")
  definition   EvaluationDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  samples      EvaluationSample[]

  @@unique([definitionId, kind])
  @@unique([definitionId, ordinal])
  @@unique([id, definitionId])
  @@map("evaluation_questions")
}

model EvaluationRun {
  id                   String                          @id @default(uuid()) @db.Uuid
  accountId            String                          @map("account_id") @db.Uuid
  brandId              String                          @map("brand_id") @db.Uuid
  definitionId         String                          @unique @map("definition_id") @db.Uuid
  inputFingerprint     String                          @map("input_fingerprint") @db.Char(64)
  status               EvaluationRunStatus             @default(EVALUATING)
  stage                EvaluationRunStage              @default(QUEUED)
  correlationId        String                          @map("correlation_id") @db.Uuid
  startedAt            DateTime                        @default(now()) @map("started_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")
  definition           EvaluationDefinition            @relation(fields: [definitionId, accountId, brandId], references: [id, accountId, brandId], onDelete: Restrict)
  samples              EvaluationSample[]
  executionCycles      EvaluationExecutionCycle[]
  synthesis            EvaluationSynthesis?
  brandResolution      EvaluationBrandResolution?
  report               EvaluationReport?
  optimizationGuidance EvaluationOptimizationGuidance?
  writerInputSnapshots WriterInputSnapshot[]           @relation("GuidanceRunWriterSnapshots")

  @@unique([id, definitionId])
  @@unique([id, accountId, brandId], map: "evaluation_runs_id_account_brand_key")
  @@unique([definitionId, accountId, brandId])
  @@index([accountId, brandId, startedAt])
  @@map("evaluation_runs")
}

model EvaluationExecutionCycle {
  id                  String                         @id @default(uuid()) @db.Uuid
  runId               String                         @map("run_id") @db.Uuid
  sequence            Int
  status              EvaluationExecutionCycleStatus @default(ACTIVE)
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  run                 EvaluationRun                  @relation(fields: [runId], references: [id], onDelete: Restrict)
  attempts            AiExecutionAttempt[]
  failures            EvaluationStageExhaustion[]
  synthesisAttempts   AiSynthesisAttempt[]
  synthesisExhaustion EvaluationSynthesisExhaustion?

  @@unique([runId, sequence])
  @@unique([id, runId])
  @@index([status, updatedAt])
  @@map("evaluation_execution_cycles")
}

model EvaluationSample {
  id             String                          @id @default(uuid()) @db.Uuid
  runId          String                          @map("run_id") @db.Uuid
  definitionId   String                          @map("definition_id") @db.Uuid
  questionId     String                          @map("question_id") @db.Uuid
  platformKey    String                          @map("platform_key") @db.VarChar(40)
  platformLabel  String                          @map("platform_label") @db.VarChar(80)
  status         EvaluationSampleStatus          @default(PENDING)
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @updatedAt @map("updated_at")
  run            EvaluationRun                   @relation(fields: [runId, definitionId], references: [id, definitionId], onDelete: Restrict)
  question       EvaluationQuestion              @relation(fields: [questionId, definitionId], references: [id, definitionId], onDelete: Restrict)
  attempts       AiExecutionAttempt[]
  evidence       EvaluationSampleEvidence?
  interpretation EvaluationSampleInterpretation?
  failures       EvaluationStageExhaustion[]

  @@unique([runId, questionId, platformKey])
  @@unique([id, runId], map: "evaluation_samples_id_run_key")
  @@index([runId, status])
  @@map("evaluation_samples")
}

model AiExecutionAttempt {
  id                     String                          @id @default(uuid()) @db.Uuid
  runId                  String                          @map("run_id") @db.Uuid
  cycleId                String                          @map("cycle_id") @db.Uuid
  sampleId               String                          @map("sample_id") @db.Uuid
  purpose                AiExecutionPurpose
  attemptNumber          Int                             @map("attempt_number")
  status                 AiExecutionAttemptStatus        @default(STARTED)
  routePolicyId          String                          @map("route_policy_id")
  providerKey            String                          @map("provider_key") @db.VarChar(80)
  requestedModel         String                          @map("requested_model") @db.VarChar(120)
  requestPayload         Json                            @map("request_payload")
  responseEnvelope       Json?                           @map("response_envelope")
  failureClass           String?                         @map("failure_class") @db.VarChar(120)
  retryable              Boolean?
  latencyMs              Int?                            @map("latency_ms")
  usage                  Json?
  correlationId          String                          @map("correlation_id") @db.Uuid
  startedAt              DateTime                        @default(now()) @map("started_at")
  finishedAt             DateTime?                       @map("finished_at")
  cycle                  EvaluationExecutionCycle        @relation(fields: [cycleId, runId], references: [id, runId], onDelete: Restrict, map: "ai_exec_attempt_cycle_run_fkey")
  sample                 EvaluationSample                @relation(fields: [sampleId, runId], references: [id, runId], onDelete: Restrict, map: "ai_exec_attempt_sample_run_fkey")
  acceptedEvidence       EvaluationSampleEvidence?       @relation("AcceptedEvidenceAttempt")
  acceptedInterpretation EvaluationSampleInterpretation? @relation("AcceptedInterpretationAttempt")
  exhaustedStage         EvaluationStageExhaustion?      @relation("ExhaustedStageAttempt")

  @@unique([cycleId, sampleId, purpose, attemptNumber], map: "ai_exec_attempt_cycle_sample_purpose_number_key")
  @@unique([id, sampleId])
  @@unique([id, cycleId, sampleId, runId], map: "ai_exec_attempt_exhaustion_identity_key")
  @@index([cycleId, purpose, status])
  @@map("ai_execution_attempts")
}

model EvaluationSampleEvidence {
  id                String                      @id @default(uuid()) @db.Uuid
  sampleId          String                      @unique @map("sample_id") @db.Uuid
  acceptedAttemptId String                      @unique @map("accepted_attempt_id") @db.Uuid
  answerContent     String                      @map("answer_content")
  answerFormat      String                      @map("answer_format") @db.VarChar(40)
  sourceMetadata    Json                        @map("source_metadata")
  searchObservation EvaluationSearchObservation @map("search_observation")
  returnedModel     String                      @map("returned_model") @db.VarChar(120)
  acceptedAt        DateTime                    @default(now()) @map("accepted_at")
  sample            EvaluationSample            @relation(fields: [sampleId], references: [id], onDelete: Restrict)
