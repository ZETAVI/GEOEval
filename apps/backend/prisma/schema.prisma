}

model AgencyAudit {
  id                   String           @id @default(uuid()) @db.Uuid
  action               String           @db.VarChar(16)
  actorAccountId       String           @map("actor_account_id") @db.Uuid
  targetAccountId      String           @map("target_account_id") @db.Uuid
  agentAccountId       String?          @map("agent_account_id") @db.Uuid
  entryKey             String?          @map("entry_key") @db.VarChar(32)
  createdAt            DateTime         @default(now()) @map("created_at")
  beforeAgentAccountId String?          @map("before_agent_account_id") @db.Uuid
  reason               String?          @db.VarChar(300)
  requestId            String?          @map("request_id") @db.Uuid
  requestIntent        Json?            @map("request_intent")
  resultRevision       Int?             @map("result_revision")
  beforeAgent          Account?         @relation("AgencyAuditBefore", fields: [beforeAgentAccountId], references: [id], onDelete: Restrict)
  actor                Account          @relation("AgencyAuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict)
  target               Account          @relation("AgencyAuditTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  agent                Account?         @relation("AgencyAuditAgent", fields: [agentAccountId], references: [id], onDelete: Restrict)
  link                 AgencyEntryLink? @relation(fields: [entryKey], references: [key], onDelete: Restrict)

  @@unique([actorAccountId, requestId])
  @@index([targetAccountId, createdAt, id])
  @@map("agency_audits")
}

model AgencyCommissionTerms {
  agentAccountId String   @id @map("agent_account_id") @db.Uuid
  enabled        Boolean  @default(false)
  rateBps        Int?     @map("rate_bps")
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at")
  agent          Account  @relation(fields: [agentAccountId], references: [id], onDelete: Restrict)

  @@map("agency_commission_terms")
}

model AgencyCommissionAudit {
  id             String   @id @default(uuid()) @db.Uuid
  agentAccountId String   @map("agent_account_id") @db.Uuid
  actorAccountId String   @map("actor_account_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  request        Json
  beforeState    Json     @map("before_state")
  afterState     Json     @map("after_state")
  reason         String   @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at")
  agent          Account  @relation("CommissionAgent", fields: [agentAccountId], references: [id], onDelete: Restrict)
  actor          Account  @relation("CommissionActor", fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([actorAccountId, requestId])
  @@index([agentAccountId, createdAt, id])
  @@map("agency_commission_audits")
}

model PublishingOrderAgency {
  orderId             String          @id @map("order_id") @db.Uuid
  agentAccountId      String?         @map("agent_account_id") @db.Uuid
  attributionRevision Int             @map("attribution_revision")
  agentActive         Boolean         @map("agent_active")
  commissionEnabled   Boolean         @map("commission_enabled")
  rateBps             Int?            @map("rate_bps")
  termsRevision       Int             @map("terms_revision")
  order               PublishingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  agent               Account?        @relation(fields: [agentAccountId], references: [id], onDelete: Restrict)

  @@index([agentAccountId, orderId])
  @@map("publishing_order_agency")
}

model SupportTicket {
  publishingOrderId String? @map("publishing_order_id") @db.Uuid
  postEndAppeal Boolean @default(false) @map("post_end_appeal")
  publishingOrder PublishingOrder? @relation(fields: [publishingOrderId, customerAccountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict)

  id String @id @default(uuid()) @db.Uuid
  sequence Int @unique @default(autoincrement())
  customerAccountId String @map("customer_account_id") @db.Uuid
  rechargeOrderId String? @map("recharge_order_id") @db.Uuid
  assigneeAccountId String? @map("assignee_account_id") @db.Uuid
  subject String @db.VarChar(100)
  status String @default("PROCESSING") @db.VarChar(16)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer Account @relation("SupportCustomer", fields: [customerAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee Account? @relation("SupportAssignee", fields: [assigneeAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recharge RechargeOrder? @relation(fields: [rechargeOrderId, customerAccountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict)
  events SupportEvent[]
  @@index([customerAccountId, sequence])
  @@index([assigneeAccountId, status, sequence])
  @@map("support_tickets")
}

model SupportEvent {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  actorAccountId String @map("actor_account_id") @db.Uuid
  actorRole String @map("actor_role") @db.VarChar(24)
  requestId String @map("request_id") @db.Uuid
  requestDigest String @map("request_digest") @db.Char(64)
  action String @db.VarChar(16)
  message String? @db.VarChar(4000)
  ticketRevision Int @map("ticket_revision")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor Account @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([actorAccountId, requestId])
  @@unique([ticketId, ticketRevision])
  @@map("support_events")
}
