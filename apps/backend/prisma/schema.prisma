  receivedAt           DateTime?                   @map("received_at") @db.Timestamptz(3)
  bodySha256           String?                     @map("body_sha256") @db.VarChar(64)
  proofKind            String?                     @map("proof_kind") @db.VarChar(32)
  sdkVersion           String?                     @map("sdk_version") @db.VarChar(32)
  requestProofSha256   String?                     @map("request_proof_sha256") @db.VarChar(64)
  responseDataSha256  String?                     @map("response_data_sha256") @db.VarChar(64)
