  @@unique([id, accountId, brandId], map: "article_generations_id_account_brand_key")
  @@unique([snapshotId, accountId, brandId], map: "article_generations_snapshot_account_brand_key")
  @@unique([accountId, brandId, idempotencyKey], map: "article_generations_account_brand_idempotency_key")
  @@index([accountId, brandId, createdAt], map: "article_generations_account_brand_created_idx")
  @@map("article_generations")
}

model CoreArticle {
