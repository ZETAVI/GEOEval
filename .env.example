# Copy only the names you need into an untracked .env file. Never commit secrets.

# Volcengine Ark: Doubao evaluation route
ARK_API_KEY=

# Alibaba Cloud Model Studio: Qwen route and platform-hosted DeepSeek backup
DASHSCOPE_API_KEY=

# Baidu AI Cloud Qianfan: ERNIE route
QIANFAN_API_KEY=

# Tencent Cloud TokenHub: platform route IDs only; exclude official-direct IDs
TOKENHUB_API_KEY=

# Optional, non-blocking observability export
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
