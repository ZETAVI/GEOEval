# Copy only the names you need into an untracked .env file. Never commit secrets.

# Application runtime. Project scripts use the same local-only defaults when
# GEOEVAL_LOCAL_DEFAULTS=1; production must inject explicit values.
DATABASE_URL=postgresql://geoeval:geoeval_local_only@127.0.0.1:55432/geoeval
REDIS_URL=redis://127.0.0.1:56379
PORT=3300
CORS_ORIGINS=http://127.0.0.1:3100,http://127.0.0.1:3200
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3300

# Agent withdrawal. Disabled by default; key is required only when enabled.
AGENCY_WITHDRAWAL_ENABLED=0
AGENCY_WITHDRAWAL_KEY_HEX=

# Alipay PC recharge. disabled is the default. verify loads signed callbacks and
# query/close recovery without allowing new payment creation, including as the
# production stop-new-payments mode; sandbox and live open their matching cashier.
# PEM files must be absolute protected
# files outside Git (0400 or 0600), never inline environment values.
RECHARGE_ALIPAY_ACTIVATION=disabled
RECHARGE_ALIPAY_ENVIRONMENT=production
RECHARGE_ALIPAY_APP_ID=
RECHARGE_ALIPAY_MERCHANT_ID=
RECHARGE_ALIPAY_PRIVATE_KEY_FILE=
RECHARGE_ALIPAY_PUBLIC_KEY_FILE=
RECHARGE_ALIPAY_NOTIFY_URL=https://app.example.com/recharges/providers/alipay/notify
RECHARGE_ALIPAY_RETURN_URL=https://app.example.com/recharges
RECHARGE_ALIPAY_TIMEOUT_MS=5000

# WeChat Pay Native recharge. verify loads credentials, callbacks and existing
# order query/close recovery while keeping new QR creation stopped; live enables
# new Native orders. There is no ordinary-merchant sandbox in this configuration.
# The merchant private key, WeChat Pay public key and APIv3 key are absolute
# protected files outside Git (0400 or 0600). Never place key contents here.
RECHARGE_WECHAT_ACTIVATION=disabled
RECHARGE_WECHAT_MERCHANT_ID=
RECHARGE_WECHAT_APP_ID=
RECHARGE_WECHAT_MERCHANT_CERT_SERIAL=
RECHARGE_WECHAT_PRIVATE_KEY_FILE=
RECHARGE_WECHAT_PUBLIC_KEY_ID=
RECHARGE_WECHAT_PUBLIC_KEY_FILE=
RECHARGE_WECHAT_API_V3_KEY_FILE=
RECHARGE_WECHAT_NOTIFY_URL=https://app.example.com/recharges/providers/wechat/notify
RECHARGE_WECHAT_API_ORIGIN=https://api.mch.weixin.qq.com
RECHARGE_WECHAT_IP_FAMILY=auto
RECHARGE_WECHAT_TIMEOUT_MS=8000

# Dedicated callback process. It binds loopback only; the public reverse proxy
# exposes the exact provider callback path. Port is independent from the full API.
RECHARGE_CALLBACK_PORT=3300

# Shared recharge business and recovery policy used by every enabled provider.
RECHARGE_MIN_AMOUNT_YUAN=1
RECHARGE_MAX_AMOUNT_YUAN=10000
RECHARGE_SHORTCUT_AMOUNTS=100,500,1000
RECHARGE_MAX_ACTIVE_ORDERS=3
RECHARGE_PAYMENT_WINDOW_SECONDS=900
RECHARGE_PAYMENT_DESCRIPTION=GEO优化服务积分充值
RECHARGE_SUPPORT_MESSAGE=请保留充值单号并稍后刷新状态。

# Brand Store Location. The JS Key is intentionally public and must be bound to
# the approved Web domain. The two security/service values remain server-only.
STORE_LOCATION_MODE=disabled
STORE_LOCATION_RECEIPT_SIGNING_SECRET=
STORE_LOCATION_RECEIPT_TTL_SECONDS=900
STORE_LOCATION_REQUEST_TIMEOUT_MS=5000
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
AMAP_WEB_SERVICE_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# Passwordless entry. Local/test remains deterministic with human verification
# disabled. Production requires both Aliyun modes, approved sign/template,
# deployment-injected minimum-permission credentials and explicit send enablement.
AUTH_CHALLENGE_MODE=deterministic
AUTH_CHALLENGE_SENDING_ENABLED=0
AUTH_DEMO_SMS_FORWARD_SOURCES=
AUTH_DEMO_SMS_FORWARD_TO=
AUTH_DEMO_SMS_FORWARD_UNTIL=
AUTH_HUMAN_VERIFICATION_MODE=disabled
AUTH_CAPTCHA_UNAVAILABLE_MODE=deny
AUTH_CAPTCHA_MAX_CONSECUTIVE_UNAVAILABLE=0
AUTH_ALIYUN_REQUEST_TIMEOUT_MS=3000
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# Prefix and SceneId are public browser configuration, not credentials.
NEXT_PUBLIC_AUTH_HUMAN_VERIFICATION_MODE=disabled
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=
AUTH_HASH_PEPPER=replace-with-at-least-32-random-characters
AUTH_DETERMINISTIC_CODE=246810
AUTH_CHALLENGE_LIFETIME_SECONDS=300
AUTH_CHALLENGE_RESEND_SECONDS=60
AUTH_CHALLENGE_WINDOW_SECONDS=3600
AUTH_CHALLENGE_MAX_REQUESTS=5
AUTH_CHALLENGE_DAILY_MAX_REQUESTS=100
AUTH_CHALLENGE_MONTHLY_MAX_REQUESTS=2500
AUTH_CHALLENGE_MAX_FAILED_ATTEMPTS=5
AUTH_CUSTOMER_SESSION_ABSOLUTE_SECONDS=604800
AUTH_CUSTOMER_SESSION_IDLE_SECONDS=86400
AUTH_INTERNAL_SESSION_ABSOLUTE_SECONDS=43200
AUTH_INTERNAL_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_SESSION_RETENTION_DAYS=30
AUTH_CHALLENGE_RETENTION_HOURS=24
AUTH_IDENTITY_CLEANUP_BATCH_SIZE=500
# Offline Bootstrap verifier only. The plaintext secret is read from protected
# standard input and must never be placed in this file or a command argument.
IDENTITY_BOOTSTRAP_SECRET_DIGEST=

# Controlled provider validation. Base URLs are non-secret and may be
# overridden when the approved commercial account uses another region or a
# workspace-dedicated host. Raw evidence stays outside Git.
E0_EVIDENCE_DIR=.provider-evidence
S6_EVIDENCE_DIR=.provider-evidence/s6-controlled
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# Product AI execution. Local development and CI remain deterministic unless
# real mode is selected explicitly. One ambiguity deadline must be longer than
# the absolute provider request deadline.
AI_EXECUTION_MODE=deterministic
# P4 opt-in; set consistently on API and Worker. Remains disabled by default.
EVALUATION_SAMPLING_MODE=ai-provider
AI_EXECUTION_CENTER_ENABLED=false
AI_EXECUTION_CENTER_ACQUISITION_ENABLED=false
# Enabling requires a separate registered execution.v1 center, caller token,
# and endpoint reference mappings for all approved Acquisition/Parser routes.
AI_PROVIDER_TIMEOUT_MS=180000
AI_ATTEMPT_AMBIGUITY_TIMEOUT_MS=210000
AI_TELEMETRY_MODE=disabled
# Default and production-safe policy. local-diagnostic is accepted only for
# explicitly controlled development/test traces with fictional or approved data.
AI_TELEMETRY_CONTENT_MODE=metadata-only

# Volcengine Ark: Doubao evaluation route
ARK_API_KEY=

# Alibaba Cloud Model Studio: Qwen platform route and DeepSeek analysis routes
DASHSCOPE_API_KEY=

# Baidu AI Cloud Qianfan: ERNIE route
QIANFAN_API_KEY=

# Tencent Cloud TokenHub: platform route IDs only; exclude official-direct IDs
TOKENHUB_API_KEY=

# Optional, non-blocking observability export
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=

# Final-order commission accrual. Enable only with an approved settlement rollout.
AGENCY_COMMISSION_ENABLED=false
