# Copy only the names you need into an untracked .env file. Never commit secrets.

# Application runtime. Project scripts use the same local-only defaults when
# GEOEVAL_LOCAL_DEFAULTS=1; production must inject explicit values.
DATABASE_URL=postgresql://geoeval:geoeval_local_only@127.0.0.1:55432/geoeval
REDIS_URL=redis://127.0.0.1:56379
PORT=3300
CORS_ORIGINS=http://127.0.0.1:3100,http://127.0.0.1:3200
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3300

# Controlled provider validation. Base URLs are non-secret and may be
# overridden when the approved commercial account uses another region or a
# workspace-dedicated host. Raw evidence stays outside Git.
E0_EVIDENCE_DIR=.provider-evidence
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# Volcengine Ark: Doubao evaluation route
ARK_API_KEY=

# Alibaba Cloud Model Studio: Qwen route and platform-hosted DeepSeek backup
DASHSCOPE_API_KEY=

# Baidu AI Cloud Qianfan: ERNIE route
QIANFAN_API_KEY=

# Tencent Cloud TokenHub: platform route IDs only; exclude official-direct IDs
TOKENHUB_API_KEY=

# Optional, non-blocking observability export
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
