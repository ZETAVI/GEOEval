[Unit]
Description=GEOEval product and AI worker
Requires=postgresql-16.service redis.service
After=network-online.target postgresql-16.service redis.service
Wants=network-online.target
PartOf=geo-runtime.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=geoeval-app
Group=geoeval
WorkingDirectory=/opt/geoeval/current/apps/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
EnvironmentFile=/etc/geoeval/application-worker.env
ExecStart=/opt/geoeval/shared/node/bin/node /opt/geoeval/current/apps/backend/dist/worker-main.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=60s
KillSignal=SIGTERM
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/geoeval
UMask=0077
Slice=geo.slice
MemoryHigh=256M
MemoryMax=320M
CPUWeight=80
TasksMax=128

[Install]
WantedBy=geo-runtime.target
