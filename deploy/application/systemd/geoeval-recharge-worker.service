[Unit]
Description=GEOEval recharge recovery and notification worker
Requires=postgresql@16-main.service
After=network-online.target postgresql@16-main.service geoeval-recharge-callback.service
Wants=network-online.target geoeval-recharge-callback.service
PartOf=geo-runtime.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=geoeval-app
Group=geoeval
WorkingDirectory=/opt/geoeval/current/apps/backend
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=64
Environment=RECHARGE_ALIPAY_PRIVATE_KEY_FILE=%d/alipay_private_key.pem
Environment=RECHARGE_ALIPAY_PUBLIC_KEY_FILE=%d/alipay_public_key.pem
EnvironmentFile=/etc/geoeval/application-recharge-worker.env
LoadCredential=alipay_private_key.pem:/opt/geoeval/shared/secrets/alipay/2021007100630148/app_private_key.pem
LoadCredential=alipay_public_key.pem:/opt/geoeval/shared/secrets/alipay/2021007100630148/alipay_public_key.pem
ExecStart=/opt/geoeval/shared/node/bin/node /opt/geoeval/current/apps/backend/dist/recharge-worker-main.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/geoeval
UMask=0077
Slice=geo.slice
MemoryHigh=96M
MemoryMax=128M
CPUWeight=80
TasksMax=96
OOMPolicy=stop

[Install]
WantedBy=geo-runtime.target
