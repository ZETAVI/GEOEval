# One-shot controlled acceptance only. Never load this file into the callback service.
NODE_ENV=production
DATABASE_URL=postgresql://geoeval@localhost/geoeval?host=%2Fvar%2Frun%2Fpostgresql

RECHARGE_ALIPAY_ACTIVATION=live
RECHARGE_ALIPAY_ENVIRONMENT=production
RECHARGE_ALIPAY_APP_ID=2021007100630148
RECHARGE_ALIPAY_MERCHANT_ID=2088631900727575
RECHARGE_ALIPAY_PRIVATE_KEY_FILE=/run/geoeval-alipay-acceptance/app_private_key.pem
RECHARGE_ALIPAY_PUBLIC_KEY_FILE=/run/geoeval-alipay-acceptance/alipay_public_key.pem
RECHARGE_ALIPAY_NOTIFY_URL=https://app.geohdp.com/recharges/providers/alipay/notify
RECHARGE_ALIPAY_RETURN_URL=https://app.geohdp.com/recharges
RECHARGE_ALIPAY_TIMEOUT_MS=8000

RECHARGE_MIN_AMOUNT_YUAN=1
RECHARGE_MAX_AMOUNT_YUAN=1
RECHARGE_SHORTCUT_AMOUNTS=1
